<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A normal permission (no prompt). Without it every upload fails with a SocketException that
         looks like "no network", so the SDK declares it rather than relying on the host app. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
